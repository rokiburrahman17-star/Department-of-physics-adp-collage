<style>
:root{--night:#062b2e;--deep:#0a4146;--photon:#2de2d0;--amber:#ffb347;--paper:#f4f7f6;--card:#fff;--tx:#17302f;--mut:#58706f;--line:#d6e2e0;--r:14px}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:70px}
body{font:16px/1.65 "IBM Plex Sans",system-ui,sans-serif;color:var(--tx);background:var(--paper)}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
:focus-visible{outline:3px solid var(--amber);outline-offset:3px}
.w{max-width:1140px;margin:0 auto;padding:0 20px}
h1,h2,h3{font-family:"Bricolage Grotesque",system-ui,sans-serif;line-height:1.15;color:var(--night)}
h2{font-size:clamp(1.7rem,3.5vw,2.4rem);margin-bottom:12px}
h3{font-size:1.2rem;margin-bottom:6px}
section{padding:72px 0}
.lead{max-width:62ch;color:var(--mut);margin-bottom:34px}
/* navigation */
header{background:var(--night);position:sticky;top:0;z-index:50}
header .w{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:64px}
.logo{display:flex;align-items:center;gap:12px;color:#fff;font-family:"Bricolage Grotesque",sans-serif;font-weight:800;font-size:1.05rem;line-height:1.1}
.logo small{display:block;font:400 .78rem "IBM Plex Sans",sans-serif;color:#9fc7c3}
.logo svg{flex:none}
nav ul{display:flex;list-style:none;gap:4px}
nav a{display:block;padding:8px 12px;color:#d8efec;font-weight:500;font-size:.95rem;border-radius:8px}
nav a:hover{background:var(--deep);color:#fff}
nav a.cta{background:var(--amber);color:#2a1a00;font-weight:600}
nav a.cta:hover{background:#ffc470}
.burger{display:none;background:none;border:1px solid #2b6a6a;color:#fff;border-radius:8px;padding:7px 12px;font:600 .95rem inherit;cursor:pointer}
/* hero: two-source interference ripples */
.hero{background:radial-gradient(120% 120% at 70% 40%,var(--deep),var(--night) 70%);color:#fff;position:relative;overflow:hidden;padding:0}
.hero .w{display:grid;grid-template-columns:1.1fr .9fr;gap:30px;align-items:center;min-height:540px}
.hero h1{color:#fff;font-size:clamp(2.3rem,5.4vw,4rem);margin-bottom:18px}
.hero p{color:#c3e3df;max-width:48ch;margin-bottom:28px;font-size:1.08rem}
.btn{display:inline-block;padding:12px 22px;border-radius:10px;font-weight:600;margin-right:10px;margin-bottom:10px}
.btn.a{background:var(--amber);color:#2a1a00}
.btn.o{border:2px solid var(--photon);color:var(--photon)}
.btn:hover{filter:brightness(1.1)}
.waves{width:100%;height:auto;max-height:520px}
.waves .ring{fill:none;stroke:var(--photon);stroke-width:1.6;transform-box:fill-box;transform-origin:center;animation:ripple 7s linear infinite;opacity:0}
.waves .r2{stroke:var(--amber)}
@keyframes ripple{0%{transform:scale(.02);opacity:.9}100%{transform:scale(1);opacity:0}}
/* about */
.split{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center}
.ph{aspect-ratio:4/3;border-radius:var(--r);overflow:hidden;background:linear-gradient(135deg,var(--deep),var(--photon));position:relative;box-shadow:0 10px 30px rgba(6,43,46,0.12)}
.ph img{width:100%;height:100%;object-fit:cover}
.facts{list-style:none;margin-top:18px;border-left:4px solid var(--photon);padding-left:16px}
.facts li{padding:4px 0}
/* labs */
.labs{background:#fff}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px}
.card{background:var(--paper);border:1px solid var(--line);border-radius:var(--r);padding:24px}
.card p{color:var(--mut);font-size:.95rem}
.card.dark{background:var(--night);border-color:var(--night)}
.card.dark h3{color:#fff}.card.dark p{color:#b5d6d2}
/* faculty */
.fac{text-align:center}
.fac .av{width:132px;height:132px;border-radius:50%;margin:0 auto 14px;overflow:hidden;background:linear-gradient(135deg,var(--photon),var(--deep));box-shadow:0 6px 16px rgba(6,43,46,0.15)}
.fac .av img{width:100%;height:100%;object-fit:cover}
/* notices */
.notes{background:var(--night);color:#d8efec}
.notes h2{color:#fff}
.nl{list-style:none;max-width:760px}
.nl li{display:flex;gap:18px;padding:16px 0;border-bottom:1px solid #1d5557}
.nl time{flex:none;width:92px;color:var(--amber);font-weight:600}
/* gallery */
.gal{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px}
.gal figure{border-radius:var(--r);overflow:hidden;background:linear-gradient(135deg,var(--deep),var(--photon));box-shadow:0 6px 20px rgba(6,43,46,0.08);display:flex;flex-direction:column}
.gal img{width:100%;aspect-ratio:4/3;object-fit:cover}
.gal figcaption{background:#fff;padding:12px 16px;font-size:.9rem;color:var(--mut);font-weight:500}
/* contact */
form{display:grid;gap:12px}
input,textarea{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:10px;font:inherit;background:#fff}
textarea{min-height:120px;resize:vertical}
button.send{justify-self:start;background:var(--night);color:#fff;border:0;border-radius:10px;padding:12px 24px;font:600 1rem inherit;cursor:pointer}
button.send:hover{background:var(--deep)}
footer{background:var(--night);color:#9fc7c3;padding:26px 0;font-size:.9rem}
footer .w{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px}
@media(max-width:860px){
 .burger{display:block}
 nav{display:none;position:absolute;left:0;right:0;top:100%;background:var(--night);padding:8px 20px 16px}
 nav.open{display:block}
 nav ul{flex-direction:column}
 .hero .w,.split{grid-template-columns:1fr}
 .hero .w{padding-top:40px;padding-bottom:20px}
 section{padding:52px 0}
}
@media(prefers-reduced-motion:reduce){.waves .ring{animation:none;opacity:.35;transform:scale(.6)}html{scroll-behavior:auto}}
</style>
