<title>সুৰৰ অনুৰণন | ADP College Physics Annual Magazine 2026</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+Bengali:wght@400;600;700&family=Noto+Sans+Bengali:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,600;9..144,800&family=Cinzel:wght@600;700&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#1b1734;
  --paper:#fcf6ea;
  --paper-soft:#f5ecda;
  --card:#fffcf5;
  --saffron:#e68a1d;
  --saffron-glow:#f7b750;
  --red:#c23923;
  --red-deep:#911f12;
  --indigo:#201e52;
  --indigo-dark:#141238;
  --line:#dfcca2;
  --line-strong:#cbaf79;
  --accent-teal:#0e7490;
  --gold-tint:#fdf3dc;
  --shadow-sm:0 4px 12px rgba(27,23,52,0.06);
  --shadow-md:0 10px 25px rgba(27,23,52,0.09);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:74px}
body{
  background:var(--paper);
  color:var(--ink);
  font:17px/1.85 "Noto Serif Bengali",Georgia,serif;
  letter-spacing:0.01em;
}
a{color:var(--red);text-decoration:none}
a:hover{text-decoration:underline}

/* Header & Hero */
.hero{
  background:linear-gradient(145deg, var(--indigo-dark) 0%, var(--indigo) 45%, #3d2b68 75%, var(--red-deep) 100%);
  color:#fff;
  text-align:center;
  padding:64px 20px 72px;
  position:relative;
  overflow:hidden;
  border-bottom:5px solid var(--saffron);
}
.hero::before{
  content:"";
  position:absolute;
  inset:0;
  background:radial-gradient(circle at 50% 30%, rgba(247,183,80,0.18), transparent 65%);
  pointer-events:none;
}
.hero-badges{
  display:inline-flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:10px;
  margin-bottom:20px;
}
.badge{
  font:600 13px/1.4 "Noto Sans Bengali",sans-serif;
  letter-spacing:0.04em;
  background:rgba(255,255,255,0.12);
  backdrop-filter:blur(6px);
  border:1px solid rgba(255,255,255,0.25);
  color:#fef3c7;
  padding:5px 14px;
  border-radius:20px;
  text-transform:uppercase;
}
.hero h1{
  font:700 clamp(42px,8vw,80px)/1.2 "Noto Serif Bengali",serif;
  margin:10px 0 6px;
  color:#fff;
  text-shadow:0 3px 18px rgba(0,0,0,0.45);
}
.hero h2{
  font:700 clamp(22px,4.5vw,36px)/1.35 "Noto Serif Bengali",serif;
  margin:0 auto 18px;
  color:var(--saffron-glow);
  max-width:700px;
}
.hero p.tagline{
  font:italic 600 clamp(16px,2.5vw,21px)/1.5 "Fraunces",Georgia,serif;
  color:#fbe4be;
  margin:20px auto 0;
  max-width:680px;
}

/* Nav */
nav{
  position:sticky;
  top:0;
  background:rgba(252,246,234,0.96);
  backdrop-filter:blur(10px);
  border-bottom:2px solid var(--line);
  display:flex;
  gap:8px;
  overflow-x:auto;
  padding:12px 20px;
  z-index:40;
  box-shadow:var(--shadow-sm);
  justify-content:center;
}
@media(max-width:820px){
  nav{justify-content:flex-start}
}
nav a{
  white-space:nowrap;
  text-decoration:none;
  color:var(--ink);
  font:600 15px "Noto Sans Bengali",sans-serif;
  padding:7px 16px;
  border-radius:24px;
  border:1px solid transparent;
  transition:all .2s ease;
}
nav a:hover,nav a:focus-visible{
  background:var(--saffron);
  color:#fff;
  outline:none;
  text-decoration:none;
  box-shadow:0 3px 10px rgba(230,138,29,0.3);
}

/* Container */
main{
  max-width:880px;
  margin:0 auto;
  padding:0 22px 80px;
}
section{
  padding-top:60px;
}

/* Headers & Accents */
.sec-title-wrap{
  display:flex;
  align-items:center;
  gap:16px;
  margin-bottom:26px;
}
h3.sec{
  font:700 clamp(28px,4.5vw,36px)/1.3 "Noto Serif Bengali",serif;
  color:var(--indigo);
  margin:0;
  position:relative;
  white-space:nowrap;
}
.sec-bar{
  flex-grow:1;
  height:3px;
  background:linear-gradient(to right, var(--saffron), transparent);
  border-radius:2px;
}
h4{
  font:700 23px/1.4 "Noto Serif Bengali",serif;
  margin:32px 0 10px;
  color:var(--indigo);
  display:flex;
  align-items:center;
  gap:8px;
}
h4::before{
  content:"";
  display:inline-block;
  width:6px;
  height:20px;
  background:var(--saffron);
  border-radius:3px;
}

/* Content typography */
p{
  margin-bottom:18px;
  color:#2b2649;
  text-align:justify;
}

/* Card styles */
.card{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:14px;
  padding:22px 26px;
  margin:20px 0 26px;
  box-shadow:var(--shadow-sm);
  position:relative;
}
.card.en{
  font-family:"Fraunces",Georgia,serif;
  font-size:16.5px;
  line-height:1.8;
  color:#26233d;
  background:#fffdfa;
  border-left:4px solid var(--saffron);
}
.card.en strong{
  color:var(--indigo);
}

/* Figures & Images */
figure{
  margin:26px 0;
  text-align:center;
  border-radius:14px;
  overflow:hidden;
  border:1px solid var(--line-strong);
  background:var(--paper-soft);
  box-shadow:var(--shadow-md);
}
figure img{
  max-width:100%;
  height:auto;
  display:block;
  margin:0 auto;
}
figcaption{
  font:500 14px/1.5 "Noto Sans Bengali",sans-serif;
  color:#635941;
  background:var(--gold-tint);
  padding:10px 16px;
  border-top:1px solid var(--line);
}

.sign{
  text-align:right;
  font-weight:700;
  margin:24px 0 16px;
  color:var(--red-deep);
  font-size:18px;
}

/* Specific elements */
.poem-card{
  background:linear-gradient(135deg, #fffaf0, #fcf3e0);
  border:2px dashed var(--line-strong);
  border-radius:18px;
  padding:36px 28px;
  margin:28px 0;
  text-align:center;
  box-shadow:var(--shadow-sm);
}
.poem{
  font-family:"Noto Serif Bengali",serif;
  font-size:18px;
  line-height:2.2;
  white-space:pre-line;
  color:var(--indigo);
  font-weight:600;
}

/* Credits grid */
.credits{
  list-style:none;
  padding:0;
  margin:20px 0;
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(240px, 1fr));
  gap:14px;
}
.credits li{
  background:var(--card);
  border:1px solid var(--line);
  padding:14px 18px;
