.course .meta{display:inline-block;color:var(--deep);font-weight:600;font-size:.85rem;margin-bottom:14px;background:#e2f2ef;padding:3px 10px;border-radius:6px;align-self:flex-start}
.course ul{padding-left:18px;font-size:.92rem;color:var(--tx)}
.course li{padding:3px 0}

/* overview notes */
.syllabus-info{margin-top:40px;background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:28px;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:24px}
.info-card h4{font-family:"Bricolage Grotesque",sans-serif;font-size:1.05rem;color:var(--night);margin-bottom:6px}
.info-card p{font-size:.92rem;color:var(--mut)}

footer{background:var(--night);color:#9fc7c3;padding:26px 0;font-size:.9rem}
footer .w{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px}

@media(max-width:860px){
