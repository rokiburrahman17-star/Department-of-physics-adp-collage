.sem summary{cursor:pointer;padding:18px 24px;font:800 1.2rem "Bricolage Grotesque",sans-serif;color:var(--night);list-style:none;display:flex;justify-content:space-between;align-items:center;user-select:none;transition:background .2s,color .2s}
.sem summary::-webkit-details-marker{display:none}
.sem summary::after{content:"+";font-size:1.6rem;line-height:1;color:var(--deep);transition:transform .25s ease,color .2s}
