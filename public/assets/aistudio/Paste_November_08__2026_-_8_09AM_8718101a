 nav{display:none;position:absolute;left:0;right:0;top:100%;background:var(--night);padding:8px 20px 16px;border-bottom:1px solid #164e52}
 nav.open{display:block}
 nav ul{flex-direction:column}
 section{padding:44px 0}
}
</style>
